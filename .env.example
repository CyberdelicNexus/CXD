# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=https://canvas.cyberdelic.design

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# Stripe Price IDs
# Get these from your Stripe Dashboard > Products
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_LIFETIME_PRICE_ID=price_xxxxx
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_xxxxx
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID=price_xxxxx

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# NVIDIA API (for Kimi K2.5)
# Get a free key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxx

# Resend Email Service
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=CXD Canvas <contact@auth.cyberdelic.design>

# Encryption Key for API key storage
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key

# AI Provider API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy-xxxxx
MOONSHOT_API_KEY=nvapi-xxxxx

# AI Model Tier Overrides (optional — defaults shown)
# CLAUDE_TIER1_MODEL=claude-sonnet-4-5-20250929
# CLAUDE_TIER2_MODEL=claude-sonnet-4-5-20250929
# GEMINI_TIER1_MODEL=gemini-2.5-pro
# GEMINI_TIER2_MODEL=gemini-2.5-pro
# KIMI_TIER1_MODEL=moonshotai/kimi-k2.5
# KIMI_TIER2_MODEL=moonshotai/kimi-k2.5

# Sentry error tracking
# DSN is the same value for both vars (NEXT_PUBLIC_ exposes it to the browser).
# Required:
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXXX.ingest.us.sentry.io/XXXXX
SENTRY_DSN=https://xxxxx@oXXXXX.ingest.us.sentry.io/XXXXX
# Optional — only needed if you want unminified stack traces (source map upload).
# Create at https://sentry.io/settings/account/api/auth-tokens/ with project:write scope.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=cxd
# SENTRY_AUTH_TOKEN=sntrys_xxxxx

# ── Sentry self-correcting loop (Phase 1) ──────────────────────────────────────
# Global kill switch: set to "false" to pause the whole loop (triage/notify).
# SENTRY_LOOP_ENABLED=true
# Sentry Web API token for reading issues + applying native snooze/ignore.
# Create a Sentry Internal Integration with scopes: event:read, issue:write.
# (Distinct from SENTRY_AUTH_TOKEN above, which is releases/source-maps only.)
# SENTRY_API_TOKEN=sntryu_xxxxx
# Internal Integration client secret — Sentry signs each webhook delivery with it
# (sentry-hook-signature = HMAC-SHA256 of the raw body).
# SENTRY_WEBHOOK_SECRET=xxxxx
# Telegram bot (decision surface). Create with @BotFather.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Your Telegram user/chat id — the ONLY id allowed to make decisions.
# TELEGRAM_CHAT_ID=123456789
# Random string; passed to setWebhook secret_token and verified per delivery.
# TELEGRAM_WEBHOOK_SECRET=xxxxx

# AI cost monitoring (overrides — defaults shown)
# Per-user daily credit caps (safety net on top of monthly_allowance).
# AI_DAILY_CAP_FREE=50
# AI_DAILY_CAP_PRO=100
# AI_DAILY_CAP_LIFETIME=100
# AI_DAILY_CAP_BETA=100
# Org-wide daily spend alert threshold (cents). Default 10000 = $100/day.
# AI_ORG_DAILY_ALERT_CENTS=10000
# Approximate $ per credit for spend conversion. Default 0.03 cents = $0.0003.
# AI_CENTS_PER_CREDIT=0.03

# AI per-tier rate limits (requests per minute per user, per endpoint).
# AI_RATE_CHAT_FREE=5
# AI_RATE_CHAT_PRO=30
# AI_RATE_CHAT_LIFETIME=60
# AI_RATE_CHAT_BETA=30
# AI_RATE_ANALYSIS_FREE=1
# AI_RATE_ANALYSIS_PRO=5
# AI_RATE_ANALYSIS_LIFETIME=10
# AI_RATE_ANALYSIS_BETA=5

# Upstash Redis (distributed rate limiter + concurrency cap)
# Required for production. Without these, code falls back to in-memory state
# which becomes per-Vercel-instance only (effective limit = configured × instance_count).
# Get from upstash.com → your Redis DB → REST API tab.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AY...

# LifeOS Compass v3 bridge — write-back endpoint (POST /api/bridge/task-writeback)
# Kill switch (PS2 B7): unset, or any value other than the exact string
# 'true', keeps the route 404ing — inert by default. Flipping this requires a
# REDEPLOY to reach already-warm serverless instances (env vars are read at
# cold start, not live-reloaded) — factor that into the kill-switch runbook.
# BRIDGE_ENABLED=true
#
# 256-bit random bearer token LifeOS sends as `x-bridge-token`. Compared
# timing-safe server-side; never logged. Generate with: openssl rand -hex 32
# BRIDGE_TOKEN=
# Previous token, kept during a rotation window so in-flight LifeOS retries
# with the old token still succeed (PS2 B1). Remove after cutover.
# BRIDGE_TOKEN_PREVIOUS=
#
# Explicit, comma-separated cxd_projects.id allowlist — NEVER "all projects
# owned by X". Checked BEFORE any DB read of the project row (PS2 B2/A3).
# Pilot = Clear Light canvas only.
# BRIDGE_PROJECT_ALLOWLIST=00000000-0000-0000-0000-000000000000
#
# Jema's CXD auth uid. The route asserts cxd_projects.owner_id equals this
# exact value before ever loading yjs_state — a leaked BRIDGE_TOKEN can only
# ever touch this one owner's allowlisted canvases (PS2 B2).
# BRIDGE_OWNER_UID=
#
# Optional — overrides the default 60 req/min per-token rate limit (PS2 B6).
# BRIDGE_RATE_LIMIT_PER_MIN=60

# Inngest (durable background jobs — emails, retries)
# In dev: not required if `npx inngest-cli@latest dev` is running locally
#   (the SDK auto-detects the dev server at localhost:8288).
# In prod: required. Create an app at https://www.inngest.com/, then grab
# the event key + signing key from the app dashboard.
INNGEST_EVENT_KEY=xxxxxxx-xxxxxxx
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxx
